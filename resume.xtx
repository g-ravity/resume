\usepackage{geometry}
\geometry{hmargin=1.15cm, vmargin=0.75cm}

\newcommand{\bodyfs}{10}      % body font size
\newcommand{\bodylead}{12} % body line spacing

% Section separator: was 8pt
\renewcommand{\sectionsep}{\vspace{6pt}}

% Section headings: was 16pt/24pt
\titleformat{\section}{\color{headings}
\scshape\fontspec[Path = fonts/lato/]{Lato-Lig}\fontsize{15pt}{19pt}\selectfont \raggedright\uppercase}{}{0em}{}

% Sub headings: was 12pt/12pt
\titleformat{\subsection}{
\color{subheadings}\fontspec[Path = fonts/lato/]{Lato-Bol}\fontsize{10.5pt}{12pt}\selectfont\bfseries\uppercase}{}{0em}{}

\renewcommand{\runsubsection}[1]{
\color{subheadings}\fontspec[Path = fonts/lato/]{Lato-Bol}\fontsize{10.5pt}{12pt}\selectfont\bfseries\uppercase {#1} \normalfont}

% Descriptor line: was 11pt/13pt
\renewcommand{\descript}[1]{
\color{subheadings}\raggedright\scshape\fontspec[Path = fonts/raleway/]{Raleway-Medium}\fontsize{9.5pt}{11pt}\selectfont {#1 \\} \normalfont}

% Date/location line: was 10pt/12pt
\renewcommand{\location}[1]{
\color{headings}\raggedright\fontspec[Path = fonts/raleway/]{Raleway-Medium}\fontsize{8.5pt}{10pt}\selectfont {#1\\} \normalfont}

% Name block: was 40pt/60pt
\renewcommand{\namesection}[3]{
\centering{
\fontsize{34pt}{44pt}
\fontspec[Path = fonts/lato/]{Lato-Hai}\selectfont #1
\fontspec[Path = fonts/lato/]{Lato-Lig}\selectfont #2
} \\[3pt]
\centering{
\color{headings}
\fontspec[Path = fonts/raleway/]{Raleway-Medium}\fontsize{10pt}{12pt}\selectfont #3}
\noindent\makebox[\linewidth]{\color{headings}\rule{\paperwidth}{0.4pt}}
\vspace{-14pt}
}

% Bullet lists: fixes the date/bullet collision the old \\[10pt] was masking
